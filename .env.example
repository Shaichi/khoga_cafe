# Copy to `.env` and fill in real values before `docker compose up`. NEVER commit the real .env.
# docker-compose reads these; the backend also accepts them as plain environment variables.

# --- Database (SQL Server SA password — must meet SQL Server complexity: 8+ chars, mixed) ---
DB_PASSWORD=Khoga@Strong#2026

# --- Auth ---
# HS256 requires >= 32 bytes. Generate e.g. `openssl rand -base64 48`.
JWT_SECRET=please-change-this-to-a-32byte-min-secret-0123456789
# The Caddy proxy terminates TLS, so the browser leg is HTTPS → keep true. Set false only for plain-HTTP staging.
COOKIE_SECURE=true

# --- CORS: comma-separated origins allowed to call the API (SPA + API are same-origin via the proxy) ---
CORS_ALLOWED_ORIGINS=https://localhost

# --- TLS reverse proxy (Caddy edge, ports 80/443) ---
# Hostname Caddy serves. "localhost" → self-signed local cert (browsers warn). A real, resolvable domain
# here + a real ACME_EMAIL below → Caddy fetches & renews a Let's Encrypt cert automatically.
SITE_ADDRESS=localhost
# "internal" → self-signed local CA. Your email (with a public SITE_ADDRESS) → Let's Encrypt.
ACME_EMAIL=internal

# --- Schema management: prod is Flyway-managed (migrations in backend db/migration), so Hibernate
#     only VALIDATES. Leave as "validate"; use "update" only for a throwaway entity-driven DB. ---
JPA_DDL_AUTO=validate

# --- Mail (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=noreply@khoga.com
MAIL_PASSWORD=dummy_password

# --- VietQR gateway ---
VIETQR_WEBHOOK_SECRET=dev-webhook-secret
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
